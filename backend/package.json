        "@types/better-sqlite3": "^9.6.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.1",
        "@types/supertest": "^7.2.1",
        "supertest": "^7.2.2",
        "tsx": "^4.23.13",
